# Sao chép file này thành .env.production trên server. Không commit secret thật.
NODE_ENV=production
PORT=8081

# SQL API Gateway hiện tại của hệ thống HR.
SQL_API_BASE=http://nhansu2.bms79.com
SQL_API_USER=

# Thay SERVER_IP_OR_DOMAIN bằng IP/domain mà trình duyệt người dùng truy cập.
# Nếu có HTTPS, dùng https://hr.example.com và bỏ :8080 khi reverse proxy ở 443.
DOCUMENT_PUBLIC_BASE_URL=http://SERVER_IP_OR_DOMAIN:8080/docserver
DOCUMENT_INTERNAL_BASE_URL=http://backend-app:8081
ONLYOFFICE_PUBLIC_URL=http://SERVER_IP_OR_DOMAIN:8080/onlyoffice

ONLYOFFICE_JWT_ENABLED=true
ONLYOFFICE_JWT_SECRET=THAY_BANG_SECRET_NGAU_NHIEN_TOI_THIEU_32_KY_TU
DRAFT_SIGNING_SECRET=THAY_BANG_SECRET_KHAC_NGAU_NHIEN_TOI_THIEU_32_KY_TU

DRAFT_TTL_HOURS=24
MAX_DOCX_SIZE_MB=20
CORS_ALLOWED_ORIGINS=http://SERVER_IP_OR_DOMAIN:8080

# Tài khoản SQL quyền tối thiểu cho các bảng contract được phép import.
SQL_SERVER=SQL_SERVER_HOST
SQL_PORT=1433
SQL_DATABASE=HR_DATABASE
SQL_USER=TAI_KHOAN_SQL_HIEN_TAI
SQL_PASSWORD=THAY_BANG_SECRET
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false
SQL_POOL_MAX=10
SQL_CONNECT_TIMEOUT_MS=15000
SQL_REQUEST_TIMEOUT_MS=300000

EXCEL_IMPORT_ENABLED=true
EXCEL_IMPORT_ALLOWED_GROUP=Admin
EXCEL_IMPORT_TEMP_DIR=
EXCEL_IMPORT_MAX_FILE_MB=25
EXCEL_IMPORT_MAX_ROWS=200000
EXCEL_IMPORT_PREVIEW_ROWS=20
EXCEL_IMPORT_BATCH_SIZE=10000
EXCEL_IMPORT_TIMEOUT_MS=300000
EXCEL_IMPORT_TTL_MINUTES=30
EXCEL_IMPORT_MAX_ERRORS=200
EXCEL_IMPORT_MAX_UNCOMPRESSED_MB=500
EXCEL_IMPORT_MAX_COLUMNS=256
EXCEL_IMPORT_MAX_HEADER_ROW=20
EXCEL_IMPORT_MAX_SHEETS=50
EXCEL_IMPORT_MAX_PENDING_PER_USER=3
EXCEL_IMPORT_MAX_CONCURRENT=2
