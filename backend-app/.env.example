NODE_ENV=development
PORT=8081
SQL_API_BASE=
SQL_API_USER=
FIELD_SYNC_CACHE_TTL_MS=120000
FIELD_SYNC_CACHE_MAX_ENTRIES=500
FIELD_SYNC_AUTH_CACHE_TTL_MS=60000
FIELD_SYNC_AUTH_CACHE_MAX_ENTRIES=1000
FIELD_SYNC_REQUEST_TIMEOUT_MS=15000
DOCUMENT_PUBLIC_BASE_URL=http://127.0.0.1:8081
DOCUMENT_INTERNAL_BASE_URL=http://host.docker.internal:8081
ONLYOFFICE_PUBLIC_URL=http://127.0.0.1:8082
ONLYOFFICE_JWT_ENABLED=false
ONLYOFFICE_JWT_SECRET=
DRAFT_SIGNING_SECRET=
DRAFT_TTL_HOURS=24
MAX_DOCX_SIZE_MB=20
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:4173,http://localhost:4173

# Kết nối SQL trực tiếp chỉ dùng phía backend cho Dashboard và Bulk Import.
SQL_SERVER=
SQL_PORT=1433
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false
SQL_POOL_MAX=10
SQL_CONNECT_TIMEOUT_MS=15000
SQL_REQUEST_TIMEOUT_MS=300000

EXCEL_IMPORT_ENABLED=true
EXCEL_IMPORT_TEMP_DIR=
EXCEL_IMPORT_MAX_FILE_MB=25
EXCEL_IMPORT_MAX_ROWS=200000
EXCEL_IMPORT_PREVIEW_ROWS=20
EXCEL_IMPORT_BATCH_SIZE=10000
EXCEL_IMPORT_TIMEOUT_MS=300000
EXCEL_IMPORT_TTL_MINUTES=30
EXCEL_IMPORT_MAX_ERRORS=200
EXCEL_IMPORT_MAX_UNCOMPRESSED_MB=500
EXCEL_IMPORT_MAX_COLUMNS=256
EXCEL_IMPORT_MAX_HEADER_ROW=20
EXCEL_IMPORT_MAX_SHEETS=50
EXCEL_IMPORT_MAX_PENDING_PER_USER=3
EXCEL_IMPORT_MAX_CONCURRENT=2
